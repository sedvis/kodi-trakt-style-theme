<?xml version="1.0" encoding="UTF-8"?>
<!-- Trakt Style browse views: 560 poster grid (movies, shows, seasons, sets), 561 episode grid. -->
<includes>
	<!-- Poster-style content: movies, shows, seasons, sets, add-on listings and Elementum's menus
	     (plugins send no content type for menus). -->
	<expression name="trakt_poster_content">Container.Content(movies) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(sets) | Container.Content(addons) | [Container.Content() + String.StartsWith(Container.FolderPath,plugin://)]</expression>
	<!-- Elementum screens only offer the Trakt views (560/561/562). -->
	<expression name="trakt_only_views">Window.IsActive(videos) + String.StartsWith(Container.FolderPath,plugin://plugin.video.elementum)</expression>
	<expression name="trakt_landscape_content">Container.Content(episodes) | Container.Content(videos)</expression>
	<include name="TraktGridHero">
		<!-- Focused title, meta and plot above the grid, like the header of a Trakt list page. -->
		<control type="group">
			<left>150</left>
			<top>108</top>
			<width>1200</width>
			<height>150</height>
			<visible>Control.IsVisible(560) | Control.IsVisible(561)</visible>
			<visible>!ListItem.IsParentFolder + !$EXP[plugin_menu_any]</visible>
			<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
			<control type="label">
				<width>1200</width>
				<height>66</height>
				<font>t_hero_s</font>
				<textcolor>text_hi</textcolor>
				<label>$VAR[TraktGridHeroTitle]</label>
			</control>
			<control type="grouplist">
				<top>66</top>
				<width>1200</width>
				<height>40</height>
				<orientation>horizontal</orientation>
				<itemgap>12</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="image">
					<top>9</top>
					<width>22</width>
					<height>22</height>
					<texture colordiffuse="accent_light">trakt/icons/star-filled.png</texture>
					<visible>!String.IsEmpty(ListItem.Rating)</visible>
				</control>
				<control type="label">
					<width>auto</width>
					<height>40</height>
					<aligny>center</aligny>
					<font>t_label_b</font>
					<textcolor>text_hi</textcolor>
					<label>$INFO[ListItem.Rating]</label>
				</control>
				<control type="label">
					<left>6</left>
					<width>auto</width>
					<height>40</height>
					<aligny>center</aligny>
					<font>t_meta</font>
					<textcolor>text_lo</textcolor>
					<label>$VAR[TraktInfoMeta]</label>
				</control>
			</control>
			<control type="textbox">
				<top>108</top>
				<width>1100</width>
				<height>40</height>
				<font>t_body</font>
				<textcolor>text_mid</textcolor>
				<label>$INFO[ListItem.Plot]</label>
			</control>
		</control>
	</include>
	<include name="TraktMenuHero">
		<control type="group">
			<left>150</left>
			<top>116</top>
			<width>1400</width>
			<height>130</height>
			<visible>Control.IsVisible(560) + $EXP[plugin_menu_any]</visible>
			<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
			<control type="label">
				<width>1400</width>
				<height>70</height>
				<font>t_hero_s</font>
				<textcolor>text_hi</textcolor>
				<label>$VAR[TraktMenuPageTitle]</label>
			</control>
			<control type="label">
				<top>70</top>
				<width>1400</width>
				<height>40</height>
				<font>t_meta</font>
				<textcolor>text_lo</textcolor>
				<label>$VAR[TraktMenuPageSubtitle]</label>
			</control>
		</control>
	</include>
	<variable name="TraktGridHeroTitle">
		<value condition="$EXP[item_is_episode]">$VAR[TraktEpisodeTitle]</value>
		<value condition="!String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>

	<include name="View_560_TraktGrid">
		<control type="group">
			<include>OpenClose_Right</include>
			<visible>Control.IsVisible(560)</visible>
			<include>Visible_Right</include>
			<control type="panel" id="560">
				<onback condition="String.IsEqual(Container.FolderPath,plugin://plugin.video.elementum/) | String.IsEqual(Container.FolderPath,addons://sources/video/)">ActivateWindow(Home)</onback>
				<left>138</left>
				<top>262</top>
				<width>1700</width>
				<height>818</height>
				<onleft>9000</onleft>
				<onright>531</onright>
				<onup condition="Integer.IsGreater(Container.NumPages,1)">560</onup>
				<onup condition="!Integer.IsGreater(Container.NumPages,1)">9000</onup>
				<ondown>560</ondown>
				<viewtype label="Poster grid">list</viewtype>
				<preloaditems>2</preloaditems>
				<pagecontrol>531</pagecontrol>
				<scrolltime tween="cubic" easing="out">420</scrolltime>
				<visible>$EXP[trakt_poster_content]</visible>
				<itemlayout width="566" height="112" condition="$EXP[plugin_menu_compact]">
					<include content="TraktMenuCard" />
				</itemlayout>
				<focusedlayout width="566" height="112" condition="$EXP[plugin_menu_compact]">
					<include content="TraktMenuCard">
						<param name="focused">Control.HasFocus(560)</param>
					</include>
				</focusedlayout>
				<itemlayout width="236" height="398">
					<include content="TraktPosterCell">
					</include>
				</itemlayout>
				<focusedlayout width="236" height="398">
					<include content="TraktPosterCell">
						<param name="focused">Control.HasFocus(560)</param>
					</include>
				</focusedlayout>
			</control>
		</control>
	</include>

	<include name="View_561_TraktEpisodes">
		<control type="group">
			<include>OpenClose_Right</include>
			<visible>Control.IsVisible(561)</visible>
			<include>Visible_Right</include>
			<control type="panel" id="561">
				<onback condition="String.IsEqual(Container.FolderPath,plugin://plugin.video.elementum/) | String.IsEqual(Container.FolderPath,addons://sources/video/)">ActivateWindow(Home)</onback>
				<left>138</left>
				<top>262</top>
				<width>1700</width>
				<height>818</height>
				<onleft>9000</onleft>
				<onright>531</onright>
				<onup condition="Integer.IsGreater(Container.NumPages,1)">561</onup>
				<onup condition="!Integer.IsGreater(Container.NumPages,1)">9000</onup>
				<ondown>561</ondown>
				<viewtype label="Episode grid">list</viewtype>
				<preloaditems>2</preloaditems>
				<pagecontrol>531</pagecontrol>
				<scrolltime tween="cubic" easing="out">420</scrolltime>
				<visible>$EXP[trakt_landscape_content]</visible>
				<itemlayout width="384" height="312">
					<include content="TraktLandscapeCell">
						<param name="title">$VAR[TraktGridEpisodeCardTitle]</param>
						<param name="subtitle">$VAR[TraktGridEpisodeCardSubtitle]</param>
					</include>
				</itemlayout>
				<focusedlayout width="384" height="312">
					<include content="TraktLandscapeCell">
						<param name="focused">Control.HasFocus(561)</param>
						<param name="title">$VAR[TraktGridEpisodeCardTitle]</param>
						<param name="subtitle">$VAR[TraktGridEpisodeCardSubtitle]</param>
					</include>
				</focusedlayout>
			</control>
		</control>
	</include>
	<expression name="container_is_one_show">String.Contains(Container.FolderPath,/season/) | String.StartsWith(Container.FolderPath,videodb://tvshows/titles/)</expression>
	<!-- Inside one show the show name is redundant, so lead with the episode; in mixed lists keep the show. -->
	<variable name="TraktGridEpisodeCardTitle">
		<value condition="$EXP[item_is_episode] + $EXP[container_is_one_show]">$VAR[TraktEpisodeTitle]</value>
		<value>$VAR[TraktCardTitle]</value>
	</variable>
	<variable name="TraktGridEpisodeCardSubtitle">
		<value condition="$EXP[item_is_episode] + $EXP[container_is_one_show]">$VAR[TraktEpisodeSubtitle]</value>
		<value>$VAR[TraktCardSubtitle]</value>
	</variable>
	<!-- ===================================================================== 562 Poster carousel -->
	<!-- One row of artwork along the bottom; the focused title gets a full backdrop and details above. -->
	<include name="View_562_TraktCarousel">
		<control type="group">
			<visible>Control.IsVisible(562)</visible>
			<include>Visible_Right</include>
			<control type="group">
				<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1920</width>
					<height>1080</height>
					<texture colordiffuse="ink">trakt/frames/white.png</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1920</width>
					<height>1080</height>
					<aspectratio>scale</aspectratio>
					<fadetime>400</fadetime>
					<texture background="true" colordiffuse="B3FFFFFF">$VAR[TraktCarouselBackdrop]</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1500</width>
					<height>1080</height>
					<texture colordiffuse="ink">trakt/gradients/left.png</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>380</top>
					<width>1920</width>
					<height>700</height>
					<texture colordiffuse="ink">trakt/gradients/bottom.png</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1920</width>
					<height>220</height>
					<texture colordiffuse="AA000000">trakt/gradients/top.png</texture>
				</control>
				<control type="image">
					<left>-300</left>
					<top>-300</top>
					<width>1900</width>
					<height>1200</height>
					<texture colordiffuse="accent_deep">trakt/gradients/glow-tl.png</texture>
					<animation effect="fade" start="100" end="50" time="0" condition="true">Conditional</animation>
				</control>
			</control>
			<!-- Hero text -->
			<control type="grouplist">
				<left>150</left>
				<top>150</top>
				<width>1240</width>
				<height>440</height>
				<orientation>vertical</orientation>
				<itemgap>10</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<visible>!ListItem.IsParentFolder</visible>
				<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
				<control type="label">
					<width>1240</width>
					<height>36</height>
					<font>t_label_b</font>
					<textcolor>accent_light</textcolor>
					<label>$VAR[TraktCarouselKicker]</label>
				</control>
				<control type="textbox">
					<width>1240</width>
					<height min="90" max="180">auto</height>
					<font>t_hero</font>
					<textcolor>text_hi</textcolor>
					<label>$VAR[TraktGridHeroTitle]</label>
				</control>
				<control type="grouplist">
					<width>1240</width>
					<height>44</height>
					<orientation>horizontal</orientation>
					<itemgap>12</itemgap>
					<usecontrolcoords>true</usecontrolcoords>
					<visible>!$EXP[item_is_tile]</visible>
					<control type="image">
						<top>10</top>
						<width>24</width>
						<height>24</height>
						<texture colordiffuse="accent_light">trakt/icons/star-filled.png</texture>
						<visible>!String.IsEmpty(ListItem.Rating)</visible>
					</control>
					<control type="label">
						<width>auto</width>
						<height>44</height>
						<aligny>center</aligny>
						<font>t_title_s</font>
						<textcolor>text_hi</textcolor>
						<label>$INFO[ListItem.Rating]</label>
					</control>
					<control type="label">
						<left>8</left>
						<width>auto</width>
						<height>44</height>
						<aligny>center</aligny>
						<font>t_meta</font>
						<textcolor>text_mid</textcolor>
						<label>$VAR[TraktInfoMeta]</label>
					</control>
				</control>
				<control type="textbox">
					<width>1000</width>
					<height min="0" max="136">auto</height>
					<font>t_body</font>
					<textcolor>text_mid</textcolor>
					<label>$INFO[ListItem.Plot]</label>
				</control>
			</control>
			<!-- The row -->
			<control type="fixedlist" id="562">
				<onback condition="String.IsEqual(Container.FolderPath,plugin://plugin.video.elementum/) | String.IsEqual(Container.FolderPath,addons://sources/video/)">ActivateWindow(Home)</onback>
				<left>138</left>
				<top>600</top>
				<width>1782</width>
				<height>470</height>
				<orientation>horizontal</orientation>
				<focusposition>0</focusposition>
				<onleft>9000</onleft>
				<onright>562</onright>
				<onup>9000</onup>
				<ondown>562</ondown>
				<viewtype label="Poster carousel">list</viewtype>
				<preloaditems>3</preloaditems>
				<scrolltime tween="cubic" easing="out">320</scrolltime>
				<visible>$EXP[trakt_poster_content] | $EXP[trakt_landscape_content]</visible>
				<!-- landscape items (episodes / videos) -->
				<itemlayout width="360" height="470" condition="$EXP[trakt_landscape_content]">
					<include content="TraktCarouselLandscapeCell">
						<param name="top">260</param>
						<param name="width">336</param>
						<param name="height">189</param>
						<param name="ring_top">253</param>
						<param name="ring_width">350</param>
						<param name="ring_height">203</param>
					</include>
				</itemlayout>
				<focusedlayout width="472" height="470" condition="$EXP[trakt_landscape_content]">
					<include content="TraktCarouselLandscapeCell">
						<param name="focused">Control.HasFocus(562)</param>
						<param name="top">198</param>
						<param name="width">448</param>
						<param name="height">252</param>
						<param name="ring_top">191</param>
						<param name="ring_width">462</param>
						<param name="ring_height">266</param>
					</include>
				</focusedlayout>
				<itemlayout width="230" height="470">
					<include content="TraktCarouselCell">
						<param name="top">140</param>
						<param name="width">206</param>
						<param name="height">309</param>
						<param name="ring_top">133</param>
						<param name="ring_width">220</param>
						<param name="ring_height">323</param>
					</include>
				</itemlayout>
				<focusedlayout width="294" height="470">
					<include content="TraktCarouselCell">
						<param name="focused">Control.HasFocus(562)</param>
						<param name="top">50</param>
						<param name="width">266</param>
						<param name="height">399</param>
						<param name="ring_top">43</param>
						<param name="ring_width">280</param>
						<param name="ring_height">413</param>
					</include>
				</focusedlayout>
				<!-- poster items and menu tiles -->
			</control>
		</control>
	</include>
	<variable name="TraktCarouselBackdrop">
		<value condition="ListItem.IsParentFolder"></value>
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
		<value condition="$EXP[item_is_episode]">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[Container.Art(fanart)]</value>
	</variable>
	<variable name="TraktCarouselKicker">
		<value condition="$EXP[item_is_episode]">$INFO[ListItem.TVShowTitle]  •  S$INFO[ListItem.Season] E$INFO[ListItem.Episode]</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">$INFO[ListItem.TVShowTitle]</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">TV Show</value>
		<value condition="String.IsEqual(ListItem.DBType,movie)">Movie</value>
		<value condition="$EXP[item_is_nextpage]">More results</value>
		<value>$INFO[Container.FolderName]</value>
	</variable>
</includes>
