<?xml version="1.0" encoding="UTF-8"?>
<addon id="repository.traktstyle" name="Trakt Style Repository" version="1.0.0" provider-name="sedvis">
	<extension point="xbmc.addon.repository" name="Trakt Style Repository">
		<dir>
			<info compressed="false">https://sedvis.github.io/kodi-trakt-style-theme/addons.xml</info>
			<checksum>https://sedvis.github.io/kodi-trakt-style-theme/addons.xml.md5</checksum>
			<datadir zip="true">https://sedvis.github.io/kodi-trakt-style-theme/</datadir>
		</dir>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Installs and updates the Trakt Style skin.</summary>
		<description lang="en_GB">Kodi add-on repository for the Trakt Style skin (a Trakt-inspired Estuary mod built around Elementum). Install the skin from Install from repository - Trakt Style Repository - Look and feel - Skin; new versions arrive through Kodi's normal add-on updates.</description>
		<platform>all</platform>
		<license>GPL-2.0-only</license>
		<source>https://github.com/sedvis/kodi-trakt-style-theme</source>
		<assets>
			<icon>icon.png</icon>
			<fanart>fanart.jpg</fanart>
		</assets>
	</extension>
</addon>
